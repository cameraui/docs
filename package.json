{
  "name": "@camera.ui/docs",
  "version": "0.0.0",
  "description": "camera.ui documentation",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "npm audit fix --min-release-age=0",
    "docs:build": "vitepress build",
    "docs:dev": "vitepress dev",
    "docs:preview": "vitepress preview",
    "install-updates": "npm i --save",
    "update": "updates -M npm,pypi,go,cargo,docker -u"
  },
  "dependencies": {
    "medium-zoom": "^1.1.2",
    "vitepress-plugin-llms": "^1.15.0"
  },
  "devDependencies": {
    "@types/markdown-it-footnote": "^3.0.4",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "12.3.0",
    "updates": "^20.0.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
